margin:15px;\">\n        <a href=\"../_static/literature_pdfs/1-s2.0-S0012825213002018-main.pdf\" target=\"_blank\" style=\"text-decoration:none; color:inherit;\">\n            <img src=\"../_static/literature_thumbs/1-s2.0-S0012825213002018-main.png\" style=\"width:180px; border:1px solid #ccc; box-shadow:2px 2px 8px rgba(0,0,0,0.15);\">\n            <div style=\"margin-top:10px; font-size:14px; word-break:break-word;\">1-s2.0-S0012825213002018-main</div>\n        </a>\n    </div>\n    \n    <div style=\"width:220px; text-align:center; margin:15px;\">\n        <a href=\"../_static/literature_pdfs/1-s2.0-S1367912009001473-main.pdf\" target=\"_blank\" style=\"text-decoration:none; color:inherit;\">\n            <img src=\"../_static/literature_thumbs/1-s2.0-S1367912009001473-main.png\" style=\"width:180px; border:1px solid #ccc; box-shadow:2px 2px 8px rgba(0,0,0,0.15);\">\n            <div style=\"margin-top:10px; font-size:14px; word-break:break-word;\">1-s2.0-S1367912009001473-main</div>\n        </a>\n    </div>\n    \n    <div style=\"width:220px; text-align:center; margin:15px;\">\n        <a href=\"../_static/literature_pdfs/Geochemistry%20and%20petrogenesis%20of%20basaltic%20rocks%20from%20the%20Develida%C4%9F%20volcanic%20complex%2C%20Central%20Anatolia%2C%20Turkey.pdf\" target=\"_blank\" style=\"text-decoration:none; color:inherit;\">\n            <img src=\"../_static/literature_thumbs/Geochemistry%20and%20petrogenesis%20of%20basaltic%20rocks%20from%20the%20Develida%C4%9F%20volcanic%20complex%2C%20Central%20Anatolia%2C%20Turkey.png\" style=\"width:180px; border:1px solid #ccc; box-shadow:2px 2px 8px rgba(0,0,0,0.15);\">\n            <div style=\"margin-top:10px; font-size:14px; word-break:break-word;\">Geochemistry and petrogenesis of basaltic rocks from the Develidağ volcanic complex, Central Anatolia, Turkey</div>\n        </a>\n    </div>\n    \n    <div style=\"width:220px; text-align:center; margin:15px;\">\n        <a href=\"../_static/literature_pdfs